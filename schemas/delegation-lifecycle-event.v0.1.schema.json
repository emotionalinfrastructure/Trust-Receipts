{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotionalinfrastructure.org/schemas/trajectory-governance/delegation-lifecycle-event.v0.1.schema.json",
  "title": "Delegation Lifecycle Event v0.1",
  "description": "Append-only lifecycle event associated with an immutable Delegation Provenance Record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "event_id",
    "event_type",
    "delegation_record_id",
    "occurred_at",
    "effective_at",
    "actor",
    "authority_reference",
    "reason_code",
    "evidence_references"
  ],
  "properties": {
    "record_type": {
      "const": "delegation_lifecycle_event"
    },
    "schema_version": {
      "const": "0.1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event_type": {
      "enum": [
        "SUSPENDED",
        "SUSPENSION_LIFTED",
        "REVOKED",
        "EXPIRY_OBSERVED",
        "CORRECTION_RECORDED"
      ]
    },
    "delegation_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_type": {
          "enum": [
            "principal",
            "authorized_administrator",
            "governance_service",
            "reviewer",
            "system"
          ]
        }
      }
    },
    "authority_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true
    },
    "previous_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "supersedes_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correction_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CORRECTION_RECORDED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "supersedes_event_id",
          "correction_note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "REVOKED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "actor_type": {
                "enum": [
                  "principal",
                  "authorized_administrator",
                  "governance_service"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
