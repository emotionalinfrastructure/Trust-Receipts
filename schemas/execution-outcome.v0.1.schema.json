{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotionalinfrastructure.org/schemas/trajectory-governance/execution-outcome.v0.1.schema.json",
  "title": "Trajectory Governance Execution Outcome v0.1",
  "description": "Append-only record of the observed result of an action linked to an action-bound authorization decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "outcome_id",
    "action_id",
    "authorization_decision_id",
    "delegation_record_id",
    "status",
    "attempted",
    "observed_at",
    "verification_status",
    "evidence_references"
  ],
  "properties": {
    "record_type": {
      "const": "execution_outcome"
    },
    "schema_version": {
      "const": "0.1"
    },
    "outcome_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authorization_decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "delegation_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "NOT_ATTEMPTED",
        "EXECUTED",
        "EXECUTION_FAILED",
        "PARTIALLY_EXECUTED",
        "OUTCOME_UNKNOWN",
        "CANCELLED"
      ]
    },
    "attempted": {
      "type": "boolean"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "provider_id"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verification_status": {
      "enum": [
        "verified",
        "unverified",
        "pending",
        "unavailable",
        "not_applicable"
      ]
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true
    },
    "before_state_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "after_state_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "exception_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "retry_classification": {
      "enum": [
        "not_retryable",
        "safe_idempotent_retry",
        "requires_reconciliation",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_ATTEMPTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempted": {
            "const": false
          },
          "verification_status": {
            "const": "not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CANCELLED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempted": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXECUTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempted": {
            "const": true
          },
          "verification_status": {
            "const": "verified"
          },
          "evidence_references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXECUTION_FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempted": {
            "const": true
          },
          "evidence_references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PARTIALLY_EXECUTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempted": {
            "const": true
          },
          "evidence_references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "OUTCOME_UNKNOWN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempted": {
            "const": true
          },
          "verification_status": {
            "enum": [
              "pending",
              "unavailable",
              "unverified"
            ]
          }
        }
      }
    }
  ]
}
