{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ei-enterprise-readiness",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "routes": [{"pattern": "readiness.emotionalinfrastructure.org", "custom_domain": true}],
  "vars": {
    "APP_ENV": "production",
    "APP_VERSION": "0.1.0-candidate.1",
    "OPENAI_MODEL": "gpt-5.6",
    "PUBLIC_BASE_URL": "https://readiness.emotionalinfrastructure.org"
  }
}
